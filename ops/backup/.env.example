# Backup job — variables de entorno. Solo nombres; los valores viven en Railway (sealed) o en el
# secret store aprobado. Nunca commitear un .env real.

# Base de origen (misma convención que la app)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Identidad del backup
BACKUP_ENV=staging            # staging | production

# Destino S3-compatible (solo tras gate #1 aprobado)
BACKUP_DESTINATION_APPROVED=  # debe ser exactamente "true"; sin esto el job aborta
BACKUP_BUCKET=
BACKUP_ENDPOINT_URL=          # vacío = AWS S3; R2/B2/Wasabi/MinIO = URL del endpoint
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Cifrado (gate #3)
BACKUP_ENCRYPTION_PASSPHRASE=

# Retención (gate #4)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
KEEP_PRE_MIGRATION=5

# Alertas (gate #6)
BACKUP_HEARTBEAT_URL=         # base URL; se llama /start, (sin sufijo) y /fail
BACKUP_MAX_AGE_HOURS=26
