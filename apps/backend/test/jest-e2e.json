{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@erp/shared-types$": "<rootDir>/../../packages/shared-types/src",
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"]
}
