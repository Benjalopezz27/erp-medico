# Reference only. Configure these values on the Railway backend service.
# Never commit real credentials or copy production data into staging.

NODE_ENV=production
PORT=3000

# Use Railway reference variables in the dashboard:
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
# DB_NAME=${{Postgres.PGDATABASE}}
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis & BullMQ Queue Configuration (Use ${{Redis.REDISHOST}} references)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=8h

# ARCA Electronic Invoicing (disabled by default until authorized credentials gate)
ARCA_ENV=disabled
# When activating homologation:
# ARCA_ENV=homologation
# ARCA_CUIT=20123456789
# ARCA_PUNTO_VENTA=1
# ARCA_CERT_BASE64=<sealed variable with Base64 PKCS#12>
# ARCA_CERT_PASSWORD=<sealed variable>
# ARCA_WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms

# Operational Security & Observability
SWAGGER_ENABLED=false
TRUST_PROXY_HOPS=2
CORS_ALLOWED_ORIGINS=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT_GLOBAL=120
THROTTLE_LIMIT_LOGIN=5

