# ==============================================================================
# ERP Distribuidora Médica — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' at the repository root for local development.
# IMPORTANT: Never commit '.env' or any actual certificate/secret to Git.
# Variables marked with [CRITICAL IN PRODUCTION] MUST be changed before deployment.
# These values are local-development examples only. Staging and production must
# use separate GitHub Environment / runtime secrets and must never copy these
# passwords, CUIT values, certificate paths, or seed credentials unchanged.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings [Active]
# ------------------------------------------------------------------------------
# Port where the NestJS backend API listens
PORT=3000

# Environment mode ('development' | 'test' | 'production')
NODE_ENV=development

# Allowed CORS origin(s) for web clients (comma-separated list for multiple origins)
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Legacy single CORS origin (maintained for backward compatibility)
FRONTEND_URL=http://localhost:5173

# Swagger documentation UI toggle ('true' | 'false' - defaults to true in dev, false in prod)
SWAGGER_ENABLED=true

# Reverse proxy trust depth (1 for standalone Nginx, 2 if behind Railway ingress)
TRUST_PROXY_HOPS=1

# Rate limiting window and limits
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT_GLOBAL=120
THROTTLE_LIMIT_LOGIN=5

# Base URL consumed by the Vite SPA (no trailing slash)
VITE_API_URL=http://localhost:3000/api/v1


# ------------------------------------------------------------------------------
# 2. Database Configuration — PostgreSQL 16 [Active]
# ------------------------------------------------------------------------------
# Hostname for PostgreSQL (use 'localhost' for local dev, 'postgres' within Docker network)
DB_HOST=localhost

# PostgreSQL listening port
DB_PORT=5432

# Database user
DB_USER=erp_user

# Database password [CRITICAL IN PRODUCTION - MUST CHANGE]
DB_PASSWORD=erp_password_dev

# Database name
DB_NAME=erp_medico

# ------------------------------------------------------------------------------
# 3. Queue & Caching — Redis 7 & BullMQ [Active in CI / Reserved for Sprint 8]
# ------------------------------------------------------------------------------
# Redis host for async queues and caching
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Local SMTP & Email Testing — Mailhog [Active in Docker Compose / Reserved for Sprint 10]
# ------------------------------------------------------------------------------
# SMTP relay host
SMTP_HOST=localhost

# SMTP server port (Mailhog SMTP default: 1025)
SMTP_PORT=1025

# Mailhog Web UI port for inspecting outgoing emails (http://localhost:8025)
MAILHOG_PORT=8025

# ------------------------------------------------------------------------------
# 5. Authentication & Initial Seed [Active in CI / S0-T13 & Sprint 1 Auth]
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (minimum 256-bit random string)
# [CRITICAL IN PRODUCTION - MUST CHANGE]
JWT_SECRET=erp_medico_jwt_dev_super_secret_key_change_in_prod_2026

# JWT token expiration time (e.g., '8h', '1d', '7d')
JWT_EXPIRATION=8h

# Initial User Seed Passwords (required for 'pnpm seed')
# MANDATORY in all environments. Never leave empty or use insecure defaults in production.
# [CRITICAL IN PRODUCTION - MUST SET SECURE PASSWORDS]
SEED_ADMIN_PASSWORD=change_admin_seed_password_2026
SEED_VENDEDOR_PASSWORD=change_vendedor_seed_password_2026

# ------------------------------------------------------------------------------
# 6. ARCA / AFIP Electronic Invoicing [Active in CI / Reserved for Sprint 8]
# ------------------------------------------------------------------------------
# ARCA environment mode ('development' = mock service | 'homologation' = AFIP test server | 'production' = live AFIP)
ARCA_ENV=development

# Registered AFIP Point of Sale number (Punto de Venta habilitado para WSFE, 1-99999)
ARCA_PUNTO_VENTA=1

# Business CUIT (11 digits, numeric only) [CRITICAL IN PRODUCTION - MUST SET REAL CUIT]
ARCA_CUIT=20123456789

# Relative path to the X.509 PKCS#12 (.p12) certificate file (for local dev; never commit certs)
ARCA_CERT_PATH=secrets/homo_cert.p12

# Alternatively, Base64-encoded PKCS#12 certificate (recommended for Railway sealed variables)
# ARCA_CERT_BASE64=

# Password/passphrase for the PKCS#12 certificate [CRITICAL IN PRODUCTION - MUST CHANGE]
ARCA_CERT_PASSWORD=change_me

# WSAA Authentication URL (defaults to AFIP test server in homologation)
ARCA_WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
