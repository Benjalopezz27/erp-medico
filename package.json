{
  "name": "erp-distribuidora-medica",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight ERP system for medical supply distributor with NestJS, TypeORM, PostgreSQL, React 19, BullMQ and ARCA/AFIP integration",
  "author": "Benjamin Lopez",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "test:e2e": "pnpm --filter @erp/backend run test:e2e",
    "dev:backend": "pnpm --filter @erp/backend run start:dev",
    "dev:frontend": "pnpm --filter @erp/frontend run dev",
    "db:migrate": "pnpm --filter @erp/backend run migration:run",
    "db:revert": "pnpm --filter @erp/backend run migration:revert",
    "seed": "pnpm --filter @erp/backend run seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod:up": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file .env.prod -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file .env.prod -f docker-compose.prod.yml logs -f",
    "docker:prod:migrate": "docker compose --env-file .env.prod -f docker-compose.prod.yml run --rm migration",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "clean": "pnpm -r exec rimraf dist node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.6": "5.0.9",
      "ip-address@10.2.0": "10.3.1",
      "js-yaml@4.1.0": "4.3.1",
      "lodash@4.17.21": "4.18.0",
      "multer@2.0.2": "2.2.0",
      "tar@7.5.16": "7.5.21",
      "undici@6.26.0": "6.27.0"
    }
  }
}
